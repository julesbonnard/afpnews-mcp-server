{
  "name": "afpnews-mcp-server",
  "version": "3.0.0-next.1",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./definitions": "./src/definitions.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test src/__tests__/",
    "test:coverage": "bun test --coverage --coverage-reporter=text src/__tests__/",
    "test:coverage:lcov": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir coverage src/__tests__/",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.4",
    "jose": "^6.2.8"
  },
  "peerDependencies": {
    "afpnews-api": "next",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "afpnews-api": "next",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0",
    "zod": "^4.4.3"
  }
}
