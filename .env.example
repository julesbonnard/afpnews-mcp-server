# AFP API
APICORE_API_KEY=your-afp-api-key
APICORE_BASE_URL=                    # optionnel

# Authentification
JWT_SECRET=                          # générer avec: openssl rand -base64 32  (min 32 chars)

# Serveur
MCP_SERVER_URL=https://news-mcp.example.com
PORT=3000                            # optionnel, défaut: 3000
MCP_TRANSPORT=http                   # stdio ou http

# Callback OAuth des clients IA distants (hors localhost, toujours autorisé).
# Liste unique, séparée par des virgules — voir README.md pour les valeurs connues.
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
